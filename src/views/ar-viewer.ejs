<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AR Viewer</title>

    <!-- MODEL VIEWER -->
    <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

    <style>
        body {
            margin: 0;
            padding: 0;
            background: #000;
            overflow: hidden;
        }
        model-viewer {
            width: 100vw;
            height: 100vh;
        }
        #loading {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 18px;
            font-family: Arial;
        }
        #launchARBtn {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            padding: 14px 24px;
            background: #f7c843;
            border: none;
            border-radius: 10px;
            font-size: 17px;
            font-weight: bold;
            color: #000;
            cursor: pointer;
            z-index: 99999;
        }
    </style>
</head>

<body>

<div id="loading">Loading AR...</div>

<!-- FIXED: Added quick-look for iOS -->
<model-viewer id="arModel"
    src="<%= modelUrl %>"
    ar
    ar-modes="scene-viewer quick-look webxr"
    camera-controls
    autoplay
    exposure="1"
    shadow-intensity="1"
    disable-zoom
    style="display:none;">
</model-viewer>

<button id="launchARBtn" style="display:none;">🚀 Launch AR</button>

<script>
    const mv = document.getElementById("arModel");
    const launchBtn = document.getElementById("launchARBtn");

    // Detect AR support using model-viewer's built-in API
    async function checkARSupport() {
        try {
            return await mv.supportsAR;
        } catch {
            return false;
        }
    }

    mv.addEventListener("load", async () => {
        document.getElementById("loading").style.display = "none";
        mv.style.display = "block";

        // Check if device can run AR
        const supportsAR = await checkARSupport();
        if (supportsAR) {
            launchBtn.style.display = "block";
        }
    });

    launchBtn.addEventListener("click", () => {
        mv.activateAR();
    });
</script>

</body>
</html>
